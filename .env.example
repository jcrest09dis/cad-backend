# Postgres
DATABASE_URL=postgres://cad:cad@localhost:5432/cad_dev

# Auth
JWT_SECRET=change-me-in-production

# First-admin bootstrap (replaces the old shared ADMIN_ENROLLMENT_SECRET).
# On startup, if no admin exists yet, this username is either promoted
# (if that staff record already exists) or created as a brand-new admin
# whose TOTP secret gets printed to the server log once - see
# lib/seedAdmin.js. Not read again once an admin exists; safe to leave
# set or clear it afterward.
SEED_ADMIN_USERNAME=

# Comma-separated list of origins allowed to call this API from a
# browser (the dispatcher console). Defaults to the console's local dev
# port. Set this to your real deployed console URL(s) before this API is
# reachable from the public internet - do not leave it at the default.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Push (stubbed providers - wire up real APNs/FCM credentials later)
# 'stub' logs to console. 'expo' sends real push through Expo's push
# service - works with the field app in Expo Go, no paid dev account needed.
PUSH_PROVIDER=stub

# Escalation ladder timing (seconds) - tune after real event observation.
# Two stages: resend push, then hand off to the dispatcher as UNCONFIRMED.
# (SMS was removed as a middle stage - Twilio trial accounts can only
# send from a small set of Twilio-predefined canned templates, not
# custom content like an incident's actual type/zone/priority, which
# made it a dead end for this project without a paid Twilio account.
# See the README if you want to reintroduce it with a paid account.)
ESCALATE_RESEND_PUSH_SEC=15
ESCALATE_DISPATCHER_ALERT_SEC=45

# Field-level encryption for Incident notes and TOTP secrets
# 'local' (default): single static key per category below, dev only.
# 'kms': real AWS KMS envelope encryption - requires
#   `npm install @aws-sdk/client-kms` and AWS credentials (env vars,
#   shared config file, or IAM role) in addition to the two key IDs below.
ENCRYPTION_PROVIDER=local

# Used when ENCRYPTION_PROVIDER=local. Two separate keys - notes (PHI)
# and auth (TOTP secrets) are never protected by the same key, even in
# this dev-only mode.
NOTES_ENCRYPTION_KEY=
AUTH_ENCRYPTION_KEY=

# Used when ENCRYPTION_PROVIDER=kms. Two separate KMS master key IDs/ARNs
# - one per data category, same separation principle as above but with a
# real HSM-backed key and KMS's own access audit trail.
KMS_NOTES_KEY_ID=
KMS_AUTH_KEY_ID=
